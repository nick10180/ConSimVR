<Project>
  <!--
    Shared build settings. Override the game location with:
      dotnet build -p:GameDir="D:\Games\Construction Simulator"
    or by setting the CONSIM_GAME_DIR environment variable.
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(CONSIM_GAME_DIR)' != ''">$(CONSIM_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Construction Simulator</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <BepInExCore>$(BepInExDir)\core</BepInExCore>
    <BepInExInterop>$(BepInExDir)\interop</BepInExInterop>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.1</Version>
  </PropertyGroup>
</Project>
